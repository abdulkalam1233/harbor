pkgname=harbor-docker
conflicts=('harbor')
pkgver=0.3.2
pkgrel=1
pkgdesc='Keyboard-driven Docker container manager: start, stop, remove, logs, and CPU and memory footprint'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'docker')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/harbor "$pkgdir/usr/bin/harbor"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/harbor.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/harbor.svg"
  install -Dm644 "$startdir/harbor.desktop" "$pkgdir/usr/share/applications/harbor.desktop"
  install -Dm644 omarchy-plugin/manifest.json "$pkgdir/usr/share/harbor/omarchy-plugin/manifest.json"
  install -Dm644 omarchy-plugin/Model.js "$pkgdir/usr/share/harbor/omarchy-plugin/Model.js"
  install -Dm644 omarchy-plugin/Panel.qml "$pkgdir/usr/share/harbor/omarchy-plugin/Panel.qml"
  install -Dm644 omarchy-plugin/i18n/en.json "$pkgdir/usr/share/harbor/omarchy-plugin/i18n/en.json"
  install -Dm644 omarchy-plugin/i18n/da.json "$pkgdir/usr/share/harbor/omarchy-plugin/i18n/da.json"
}

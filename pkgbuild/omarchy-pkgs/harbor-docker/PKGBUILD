# Maintainer: Abdul Kalam <abdul@incubyte.co>

pkgname=harbor-docker
pkgver=0.3.2
pkgrel=1
pkgdesc='Keyboard-driven Docker container manager: start, stop, remove, logs, and CPU and memory footprint'
arch=('x86_64' 'aarch64')
url='https://github.com/abdulkalam1233/harbor'
license=('MIT')
conflicts=('harbor')
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
)
optdepends=('docker: the containers Harbor manages')
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/abdulkalam1233/harbor/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9f16b031a2d6f45bdc364c2ad00ab22b79560a5536a6a891fa65cc6cbf4c2135')

build() {
  cd "$srcdir/harbor-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/harbor-$pkgver"

  install -Dm755 build/harbor "$pkgdir/usr/bin/harbor"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/harbor.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/harbor.svg"
  install -Dm644 pkgbuild/harbor.desktop "$pkgdir/usr/share/applications/harbor.desktop"

  local plugin="$pkgdir/usr/share/harbor/omarchy-plugin"
  install -Dm644 omarchy-plugin/manifest.json "$plugin/manifest.json"
  install -Dm644 omarchy-plugin/Model.js "$plugin/Model.js"
  install -Dm644 omarchy-plugin/Panel.qml "$plugin/Panel.qml"
  install -Dm644 omarchy-plugin/i18n/en.json "$plugin/i18n/en.json"
  install -Dm644 omarchy-plugin/i18n/da.json "$plugin/i18n/da.json"
}
